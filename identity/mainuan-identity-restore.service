[Unit]
Description=Restauração da identidade visual do Mainuan
Documentation=https://github.com/mainuan/dot-files
# Arquivos de sistema apenas: depois de montar /usr e /etc, antes da tela de
# login, para que o SDDM e as novas contas já encontrem os arquivos certos.
After=local-fs.target
Before=display-manager.service systemd-user-sessions.service
ConditionPathExists=/usr/share/mainuan/identity/manifest.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/mainuan-identity/mainuan-identity-restore
TimeoutStartSec=60
UMask=0022
# Somente os diretórios dos destinos do manifesto aceitam escrita
# (identity/update-manifest.py --check confere esta lista).
ProtectSystem=strict
ReadWritePaths=-/etc/skel -/usr/share/plasma/avatars -/usr/share/icons/hicolor/scalable/apps
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
IPAddressDeny=any
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
