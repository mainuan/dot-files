#!/bin/sh
set -e

PACKAGE="mainuan-user-avatar"
DIVERT_DIR="/var/lib/mainuan-user-avatar/diverted"

add_diversion() {
    original="$1"
    diverted="$2"

    # Não registrar novamente uma diversion existente.
    if dpkg-divert --list "$original" |
        grep -Fq "diversion of $original to $diverted by $PACKAGE"; then
        return 0
    fi

    mkdir -p "$DIVERT_DIR"

    # Se o destino já estiver ocupado, usar outro nome.
    if [ -e "$diverted" ] || [ -L "$diverted" ]; then
        diverted="${diverted}.previous"
    fi

    # Registrar a diversion e mover o arquivo original.
    dpkg-divert \
        --package "$PACKAGE" \
        --add \
        --rename \
        --divert "$diverted" \
        "$original"
}

case "$1" in
    install|upgrade)
        add_diversion \
            /etc/skel/.face \
            "$DIVERT_DIR/skel.face"

        add_diversion \
            /usr/share/plasma/avatars/kubuntu-bug.png \
            "$DIVERT_DIR/kubuntu-bug.png"

        add_diversion \
            /usr/share/sddm/themes/breeze/faces/.face.icon \
            "$DIVERT_DIR/breeze.face.icon"
        ;;
esac

#DEBHELPER#

exit 0
