#!/bin/sh
set -e

# Removing these Mainuan-owned directories disables 60-mainuan-theme.cfg,
# whose options are guarded by the existence of theme.txt.
case "$1" in
    remove|purge)
        rm -rf /boot/grub/themes/mainuan \
               /boot/grub/themes/mainuan.dpkg-new \
               /boot/grub/themes/mainuan.dpkg-old
        if [ -e /boot/grub/grub.cfg ] && command -v update-grub >/dev/null 2>&1; then
            update-grub || echo "mainuan-grub-theme: update-grub falhou; rode-o de novo" >&2
        fi
        ;;
esac

#DEBHELPER#

exit 0
