#!/bin/sh
set -e

# Desfaz os desvios criados pelo preinst assim que os arquivos deste pacote
# saem do disco. Quando o caminho original está livre, o arquivo do pacote
# dono volta para ele (--rename); se algo ocupa o caminho, esse arquivo é
# mantido e o original fica em /var/lib/mainuan-user-avatar/diverted.

case "$1" in
    remove|abort-install|disappear)
        if [ -e /etc/skel/.face ] || [ -L /etc/skel/.face ]; then
            echo "mainuan-user-avatar: /etc/skel/.face existe; original mantido em /var/lib/mainuan-user-avatar/diverted" >&2
            dpkg-divert --package mainuan-user-avatar --remove --no-rename --divert /var/lib/mainuan-user-avatar/diverted/skel.face /etc/skel/.face
        else
            dpkg-divert --package mainuan-user-avatar --remove --rename --divert /var/lib/mainuan-user-avatar/diverted/skel.face /etc/skel/.face
        fi
        f=/usr/share/sddm/themes/breeze/faces/.face.icon
        if [ -e "$f" ] || [ -L "$f" ]; then
            echo "mainuan-user-avatar: $f existe; original mantido em /var/lib/mainuan-user-avatar/diverted" >&2
            dpkg-divert --package mainuan-user-avatar --remove --no-rename --divert /var/lib/mainuan-user-avatar/diverted/breeze.face.icon "$f"
        else
            dpkg-divert --package mainuan-user-avatar --remove --rename --divert /var/lib/mainuan-user-avatar/diverted/breeze.face.icon "$f"
        fi
        if [ -e /usr/share/plasma/avatars/kubuntu-bug.png ] || [ -L /usr/share/plasma/avatars/kubuntu-bug.png ]; then
            echo "mainuan-user-avatar: /usr/share/plasma/avatars/kubuntu-bug.png existe; original mantido em /var/lib/mainuan-user-avatar/diverted" >&2
            dpkg-divert --package mainuan-user-avatar --remove --no-rename --divert /var/lib/mainuan-user-avatar/diverted/kubuntu-bug.png /usr/share/plasma/avatars/kubuntu-bug.png
        else
            dpkg-divert --package mainuan-user-avatar --remove --rename --divert /var/lib/mainuan-user-avatar/diverted/kubuntu-bug.png /usr/share/plasma/avatars/kubuntu-bug.png
        fi
        rmdir --ignore-fail-on-non-empty /var/lib/mainuan-user-avatar/diverted /var/lib/mainuan-user-avatar 2>/dev/null || true
        ;;
esac

#DEBHELPER#

exit 0
