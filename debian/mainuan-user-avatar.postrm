#!/bin/sh
set -e

PACKAGE="mainuan-user-avatar"
# sha256 de /usr/share/mainuan/identity/avatars/cyan.svg (o /etc/skel/.face
# criado pelo postinst); conferido no CI.
FACE_SHA256=25a743421756f49406bebc7f6384cbb1c418bec05e29a377a5ed0cddbd114c74

remove_diversion() {
    original="$1"

    # Descobre se existe uma diversion pertencente ao pacote.
    entry=$(dpkg-divert --list "$original" |
        grep -F "diversion of $original to " |
        grep -F " by $PACKAGE" || true)

    [ -n "$entry" ] || return 0

    # Extrai o destino registrado.
    diverted=${entry#* to }
    diverted=${diverted% by "$PACKAGE"}

    if [ -e "$original" ] || [ -L "$original" ]; then
        echo "mainuan-user-avatar: $original existe; preservando o arquivo original em $diverted" >&2

        dpkg-divert \
            --package "$PACKAGE" \
            --remove \
            --no-rename \
            --divert "$diverted" \
            "$original"
    else
        dpkg-divert \
            --package "$PACKAGE" \
            --remove \
            --rename \
            --divert "$diverted" \
            "$original"
    fi
}

case "$1" in
    remove|abort-install|disappear)
        # O /etc/skel/.face do postinst não pertence a pacote nenhum: sai
        # antes de o original do Kubuntu voltar ao lugar. Um arquivo alterado
        # pelo administrador fica (e o original continua desviado).
        if [ -f /etc/skel/.face ] && [ ! -L /etc/skel/.face ] &&
            [ "$(sha256sum < /etc/skel/.face | cut -d' ' -f1)" = "$FACE_SHA256" ]; then
            rm -f /etc/skel/.face
        fi
        remove_diversion /etc/skel/.face

        remove_diversion \
            /usr/share/sddm/themes/breeze/faces/.face.icon

        remove_diversion \
            /usr/share/plasma/avatars/kubuntu-bug.png

        rmdir --ignore-fail-on-non-empty \
            /var/lib/mainuan-user-avatar/diverted \
            /var/lib/mainuan-user-avatar 2>/dev/null || true
        ;;
esac

#DEBHELPER#

exit 0
