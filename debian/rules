#!/usr/bin/make -f

PKG := debian/mainuan-desktop-defaults
AVATAR := debian/mainuan-user-avatar
GRUBTHEME := debian/mainuan-grub-theme/usr/share/grub/themes/mainuan
PLASMOIDS := $(PKG)/usr/share/plasma/plasmoids

%:
	dh $@

execute_after_dh_install:
	# Plymouth: every image of the theme is a real file of this package (the
	# initramfs hook does not follow links out of the theme directory).
	test -s $(PKG)/usr/share/plymouth/themes/mainuan/throbber-0048.png
	if find $(PKG)/usr/share/plymouth -type l | grep .; then exit 1; fi
	# Calamares slideshow translations (Qt): lang/calamares-vendor_<lang>.qm.
	mkdir -p $(PKG)/etc/calamares/branding/vendor/lang
	for ts in tools/calamares-slides/lang/calamares-vendor_*.ts; do \
		/usr/lib/qt6/bin/lrelease -silent $$ts -qm $(PKG)/etc/calamares/branding/vendor/lang/$$(basename $$ts .ts).qm; \
	done
	test -s $(PKG)/etc/calamares/branding/vendor/lang/calamares-vendor_pt_BR.qm
	# Calamares 3.3.14 catalogs with lost %N placeholders fixed (pt_BR showed
	# "Configure timezone para 1"). Calamares reads
	# /usr/share/calamares/lang/calamares_<lang>.qm before the copy built
	# into its binary; the other languages keep the built-in one.
	python3 tools/calamares-lang/fix-placeholders.py --check
	mkdir -p $(PKG)/usr/share/calamares/lang
	for ts in tools/calamares-lang/lang/calamares_*.ts; do \
		/usr/lib/qt6/bin/lrelease -silent $$ts -qm $(PKG)/usr/share/calamares/lang/$$(basename $$ts .ts).qm; \
	done
	test -s $(PKG)/usr/share/calamares/lang/calamares_pt_BR.qm
	# GRUB theme fonts, generated from Noto Sans (names used by theme.txt).
	sh tools/boot-art/make-grub-fonts.sh /usr/share/fonts/truetype/noto $(GRUBTHEME)
	for f in $$(grep -o '"Noto Sans[^"]*"' $(GRUBTHEME)/theme.txt | sort -u | tr -d '"' | tr 'A-Z ' 'a-z_'); do \
		test -s $(GRUBTHEME)/$$f.pf2; \
	done
	# Fontes de tradução, pacote .plasmoid, capturas do leia-me, leia-mes e
	# licenças dos widgets ficam no pacote-fonte; as licenças estão em
	# debian/copyright. Os catálogos usados pelo Plasma ficam em
	# contents/locale.
	rm -rf $(PLASMOIDS)/ChatAI-Plasmoid/ChatAI-Plasmoid.plasmoid \
	       $(PLASMOIDS)/ChatAI-Plasmoid/locale \
	       $(PLASMOIDS)/org.kde.plasma.powershowdesktop/images \
	       $(PLASMOIDS)/org.kde.plasma.powershowdesktop/translate
	find $(PLASMOIDS) \( -name 'LICENSE*' -o -name 'README*' -o -name '*~' \) \
	    -type f -delete
	# /etc/skel/.face pertence ao kubuntu-settings-desktop: vai para o
	# mainuan-user-avatar, que o desvia. Lá a imagem fica fora de /etc e
	# /etc/skel/.face é um link para ela (debian/mainuan-user-avatar.links):
	# um conffile no lugar de um conffile desviado faria o dpkg perguntar
	# sobre o arquivo nas instalações e atualizações dos dois pacotes.
	rm $(PKG)/etc/skel/.face
	install -D -m 0644 rootfs/etc/skel/.face $(AVATAR)/usr/share/mainuan-user-avatar/face.svg

execute_after_dh_fixperms:
	# Configurações e widgets são dados: nenhum arquivo precisa ser executável.
	find $(PKG) $(AVATAR) -path '*/DEBIAN' -prune -o -type f -perm /111 \
	    -exec chmod a-x {} +
