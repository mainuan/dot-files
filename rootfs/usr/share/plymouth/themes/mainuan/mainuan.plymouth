[Plymouth Theme]
Name=Mainuan
Name[pt_BR]=Mainuan
Description=Tela de inicialização do Mainuan: logotipo com um anel que gira ao redor.
ModuleName=two-step

[two-step]
Font=Noto Sans 12
TitleFont=Noto Sans Light 24
# Logo (watermark.png) and the ring (throbber-*.png) share the same centre;
# both come from tools/boot-art/generate.py.
ImageDir=/usr/share/plymouth/themes/mainuan
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.5
HorizontalAlignment=.5
VerticalAlignment=.5
# Password prompt and messages below the logo, never over it.
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.72
TitleHorizontalAlignment=.5
TitleVerticalAlignment=.28
MessageBelowAnimation=true
Transition=none
TransitionDuration=0.0
BackgroundStartColor=0x121a1e
BackgroundEndColor=0x0a0f12
ProgressBarBackgroundColor=0x1c272c
ProgressBarForegroundColor=0x0dd8e3

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false

[updates]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Instalando atualizações...
SubTitle=Não desligue o computador

[system-upgrade]
SuppressMessages=true
ProgressBarShowPercentComplete=true
UseProgressBar=true
Title=Atualizando o sistema...
SubTitle=Não desligue o computador
